@model ReceiptForm
@{ ViewData["Title"] = "Nhập kho"; }
<div class="page-heading"><div><a asp-action="Index" class="back-link">← Sổ kho</a><h1>Nhập bổ sung hàng</h1><p>Ghi nhận số lượng thực tế nhận vào cửa hàng.</p></div></div><form method="post" class="panel form-panel"><input asp-for="RequestId" type="hidden" /><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="ProductId" class="form-label"></label><select asp-for="ProductId" asp-items="ViewBag.Products" class="form-select"><option value="">Chọn sản phẩm</option></select></div><div class="mb-3"><label asp-for="Quantity" class="form-label"></label><input asp-for="Quantity" class="form-control" /></div><div class="mb-3"><label asp-for="Note" class="form-label"></label><textarea asp-for="Note" class="form-control" rows="3" placeholder="Ví dụ: Nhập từ nhà cung cấp, phiếu số…"></textarea></div><div class="form-actions"><button class="btn btn-primary">Xác nhận nhập kho</button><a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div></form>
