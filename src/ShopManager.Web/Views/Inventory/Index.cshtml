@model PagedList<StockMovement>
@{ ViewData["Title"] = "Kho hàng"; }
<div class="page-heading"><div><div class="eyebrow">KIỂM SOÁT TỒN KHO</div><h1>Sổ kho</h1><p>Lịch sử nhập, bán và hoàn hàng — mỗi thay đổi đều được ghi nhận.</p></div><a asp-action="Receive" class="btn btn-primary">＋ Nhập kho</a></div><section class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>Thời gian</th><th>Sản phẩm</th><th>Biến động</th><th>Loại</th><th>Nội dung</th><th>Thực hiện</th></tr></thead><tbody>@foreach (var m in Model.Items) { <tr><td>@VietnamTime.Format(m.CreatedAt)</td><td><strong>@m.Product.Name</strong><small class="d-block subtle">@m.Product.Sku</small></td><td class="@(m.Delta > 0 ? "text-success" : "text-danger") fw-bold">@(m.Delta > 0 ? "+" : "")@m.Delta</td><td>@(m.Type == MovementType.Receipt ? "Nhập kho" : m.Type == MovementType.Sale ? "Bán hàng" : "Hoàn đơn")</td><td>@m.Note @if (m.SaleOrderId.HasValue) { <a asp-controller="Orders" asp-action="Details" asp-route-id="@m.SaleOrderId">HD@(m.SaleOrderId.Value.ToString("D6"))</a> }</td><td>@m.CreatedBy.FullName</td></tr> } @if (Model.Items.Count == 0) { <tr><td colspan="6" class="empty-cell">Chưa có giao dịch kho.</td></tr> }</tbody></table></div><partial name="_Pagination" /></section>
