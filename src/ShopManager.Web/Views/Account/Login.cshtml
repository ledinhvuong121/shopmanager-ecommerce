@model LoginForm
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="login-wrap"><section class="login-story"><div class="brand light"><span class="brand-icon">S</span> ShopManager</div><div><span class="eyebrow">MỖI NGÀY, MỘT KHỞI ĐẦU TỐT</span><h1>Cửa hàng gọn gàng.<br />Kinh doanh nhẹ nhàng.</h1><p>Từ sản phẩm đầu tiên đến đơn hàng tiếp theo,<br />mọi thứ đều trong tầm tay bạn.</p><div class="story-grid"><div>▦<small>Quản lý sản phẩm</small></div><div>⇄<small>Theo dõi tồn kho</small></div><div>↗<small>Nắm bắt doanh thu</small></div></div></div><small>Không gian quản lý dành cho cửa hàng của bạn.</small></section>
<section class="login-form"><div class="eyebrow">CHÀO MỪNG TRỞ LẠI</div><h2>Đăng nhập cửa hàng</h2><p class="subtle">Đăng nhập để mua hàng hoặc quản lý cửa hàng.</p><form method="post" asp-action="Login"><input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="All" class="text-danger"></div><div class="mb-4"><label asp-for="Identifier" class="form-label"></label><input asp-for="Identifier" class="form-control" autocomplete="username" placeholder="Tên tài khoản hoặc email" /></div><div class="mb-4"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="current-password" /></div><button class="btn btn-primary w-100" type="submit">Đăng nhập →</button></form><p class="mt-3"><a asp-action="Register">Đăng ký tài khoản khách hàng</a></p><p><a asp-controller="Orders" asp-action="Create">Quay lại cửa hàng</a></p><p class="login-note">Quên mật khẩu? Liên hệ người quản lý cửa hàng.</p></section></div>
