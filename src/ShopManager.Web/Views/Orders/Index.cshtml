@model PagedList<SaleOrder>
@{ ViewData["Title"] = "Đơn hàng"; var vi = CultureInfo.GetCultureInfo("vi-VN"); }
<div class="page-heading"><div><div class="eyebrow">HOẠT ĐỘNG BÁN HÀNG</div><h1>Đơn hàng <span class="count-pill">@Model.TotalCount</span></h1><p>@(User.IsInRole(Roles.Manager) ? "Theo dõi toàn bộ giao dịch của cửa hàng." : "Theo dõi các đơn hàng do bạn tạo.")</p></div><a asp-action="Create" class="btn btn-primary">＋ @(User.IsInRole(Roles.Customer) ? "Mua hàng" : "Tạo đơn bán")</a></div><section class="panel"><form method="get" class="search-bar"><label class="visually-hidden" for="search">Tìm đơn hàng</label><input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Mã đơn hoặc tên khách hàng…" /><label class="visually-hidden" for="status">Trạng thái</label><select id="status" name="status" class="form-select"><option value="">Tất cả trạng thái</option><option value="Completed" selected="@(ViewBag.Status == OrderStatus.Completed)">Hoàn tất</option><option value="AwaitingDelivery" selected="@(ViewBag.Status == OrderStatus.AwaitingDelivery)">Chờ giao hàng</option><option value="OutForDelivery" selected="@(ViewBag.Status == OrderStatus.OutForDelivery)">Đang giao</option><option value="Cancelled" selected="@(ViewBag.Status == OrderStatus.Cancelled)">Đã hủy</option></select><button class="btn btn-outline-secondary">Lọc đơn</button></form><div class="table-responsive"><table class="table"><thead><tr><th>Mã đơn / thời gian</th><th>Khách hàng</th><th>Người đặt / lập đơn</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var o in Model.Items) { <tr><td><a asp-action="Details" asp-route-id="@o.Id"><strong>@o.Code</strong></a><small class="d-block subtle">@VietnamTime.Format(o.CreatedAt)</small></td><td>@o.CustomerName</td><td>@o.CreatedBy.FullName</td><td class="money">@o.Total.ToString("N0", vi) ₫</td><td><span class="badge-status @(o.Status == OrderStatus.Completed ? "success" : "muted")">@(o.Status == OrderStatus.Completed ? "Hoàn tất" : o.Status == OrderStatus.AwaitingDelivery ? "Chờ giao hàng" : o.Status == OrderStatus.OutForDelivery ? "Đang giao" : "Đã hủy")</span></td><td><a asp-action="Details" asp-route-id="@o.Id">Chi tiết →</a></td></tr> } @if (Model.Items.Count == 0) { <tr><td colspan="6" class="empty-cell">Chưa có đơn hàng phù hợp.</td></tr> }</tbody></table></div><partial name="_Pagination" /></section>

