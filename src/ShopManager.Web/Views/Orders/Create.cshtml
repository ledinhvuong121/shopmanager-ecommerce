@model CheckoutForm
@{
    var guest = User.Identity?.IsAuthenticated != true;
    var customer = User.IsInRole(Roles.Customer);
    var storefront = guest || customer;
    var cartOnly = false;
    var cartKey = guest ? "shopmanager-cart:guest" :
        customer ? "shopmanager-cart:" + User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value : null;
    var unitsSold = ViewBag.UnitsSold as Dictionary<int, long>;
    var ratings = ViewBag.Ratings as Dictionary<int, double>;
}
@{ ViewData["Title"] = cartOnly ? "Giỏ hàng" : storefront ? "Mua hàng" : "Bán hàng"; var products = (List<Product>)ViewBag.Products; var vi = CultureInfo.GetCultureInfo("vi-VN"); }
<div class="page-heading"><div><div class="eyebrow">@(storefront ? "CỬA HÀNG" : "QUẦY BÁN HÀNG")</div><h1>@(cartOnly ? "Giỏ hàng" : storefront ? "Mua hàng" : "Tạo đơn bán")</h1><p>@(cartOnly ? "Kiểm tra sản phẩm và tổng tiền trước khi đặt hàng." : storefront ? "Đặt hàng online và thanh toán tiền mặt khi nhận hàng." : "Chọn sản phẩm, kiểm tra giỏ hàng và xác nhận thanh toán.")</p></div>@if (guest)
{
    <div class="d-flex gap-2">
        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Create", "Orders")" class="btn btn-outline-secondary">Đăng nhập</a>
        <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Đăng ký</a>
    </div>
}
else { <a asp-action="Index" class="btn btn-outline-secondary">Lịch sử đơn hàng</a> }
</div>
<div asp-validation-summary="All" class="alert alert-danger validation-summary"></div>
<div class="@(cartOnly ? "cart-page" : "pos-grid")"><section id="shop-products" hidden="@cartOnly"><div class="pos-search"><label class="visually-hidden" for="product-search">Tìm sản phẩm</label><input id="product-search" type="search" class="form-control" placeholder="Tìm sản phẩm theo tên hoặc mã…" />@if (storefront)
{
    <label for="category-filter" class="visually-hidden">Danh mục</label>
    <select id="category-filter" class="form-select mb-2">
        <option value="">Tất cả danh mục</option>
        @foreach (var category in products.Select(p => p.Category).DistinctBy(c => c.Id).OrderBy(c => c.Name))
        {
            <option value="@category.Id">@category.Name</option>
        }
    </select>
}
<span id="product-count" class="subtle">@products.Count sản phẩm còn hàng</span></div><div class="catalog-grid">
@foreach (var p in products)
{
    var image = ProductImages.Find(p.Sku);
    <div class="catalog-entry">
    <button type="button" class="catalog-card" data-id="@p.Id" data-category="@p.CategoryId" data-search="@p.Name @p.Sku"><div class="catalog-art art-@(p.CategoryId % 4)">@if (image is not null) { <img class="catalog-photo" src="@image" alt="" loading="lazy" referrerpolicy="no-referrer" /> }
    else { <span aria-hidden="true">▦</span> }<small>@p.Category.Name</small><b>＋</b></div><div class="catalog-info"><small>@p.Sku · Còn @p.Stock</small><strong>@p.Name</strong><span>@p.Price.ToString("N0", vi) ₫</span></div></button>
    @if (storefront)
    {
        <div class="catalog-feedback">
            <span>Đã bán @(unitsSold!.GetValueOrDefault(p.Id).ToString("N0", vi))</span>
            <a asp-action="Reviews" asp-route-id="@p.Id">
                @(ratings!.TryGetValue(p.Id, out var rating) ? $"★ {rating.ToString("0.0", vi)}/5" : "Chưa có đánh giá")
            </a>
        </div>
    }
    </div>
}
</div><div id="no-products" class="empty-state" hidden="@(products.Count > 0)"><h3>Không có sản phẩm phù hợp</h3><p>Thử từ khóa khác.</p></div></section>
<form method="post" asp-action="Create" id="checkout-form" data-cart-key="@cartKey" data-guest="@guest.ToString().ToLowerInvariant()" class="panel cart-panel"><input asp-for="RequestId" type="hidden" /><div class="panel-heading"><h2>Giỏ hàng <span id="cart-count" class="count-pill">0</span></h2><button id="clear-cart" type="button" class="btn btn-link btn-sm">Xóa giỏ</button></div>@if (!storefront) { <div class="cart-customer"><label asp-for="CustomerId" class="form-label">Khách hàng</label><select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select"><option value="">Khách vãng lai</option></select></div> }@if (customer)
{
    <div class="cart-customer">
        <label asp-for="ShippingAddress" class="form-label"></label>
        <textarea asp-for="ShippingAddress" class="form-control" autocomplete="street-address" maxlength="300" rows="2" required></textarea>
    </div>
}
<div id="cart-items" aria-live="polite"></div><div id="cart-inputs"></div><div class="cart-totals">
@if (customer)
{
    <label asp-for="VoucherCode" class="form-label"></label>
    <input asp-for="VoucherCode" class="form-control mb-2" autocomplete="off" maxlength="32"
           data-code="@OrderService.SampleVoucher" data-percent="@OrderService.VoucherPercent" data-limit="@OrderService.VoucherLimit" />
    <small class="d-block subtle mb-3">Dùng @OrderService.SampleVoucher để giảm @OrderService.VoucherPercent%, tối đa @OrderService.VoucherLimit.ToString("N0", vi) ₫.</small>
    <div><span>Giảm giá</span><span id="voucher-discount">0 ₫</span></div>
}
<div><span>Tổng thanh toán</span><strong id="cart-total">0 ₫</strong></div>@if (!storefront) { <label asp-for="CashReceived" class="form-label"></label><input asp-for="CashReceived" type="number" step="1" min="0" class="form-control" /><button id="exact-cash" type="button" class="btn btn-link btn-sm px-0">Khách đưa vừa đủ</button><div class="change-row"><span>Tiền trả lại</span><strong id="cash-change">0 ₫</strong></div> }<p id="cart-error" class="text-danger" role="alert"></p>@if (guest)
{
    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Create", "Orders")" class="btn btn-primary w-100">Đăng nhập để đặt hàng</a>
}
else { <button id="checkout-button" type="submit" class="btn btn-primary w-100">@(customer ? "Đặt hàng" : "Xác nhận thanh toán") →</button> }<small class="cart-note">@(storefront ? "Thanh toán khi nhận hàng (COD)." : "Thanh toán tiền mặt · Tồn kho được kiểm tra khi lưu đơn.")</small></div></form></div>
@section Scripts {
<script id="catalog-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(products.Select(p => new { id = p.Id, name = p.Name, sku = p.Sku, price = p.Price, stock = p.Stock })))</script>
<script id="initial-cart" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Lines.Select(l => new { productId = l.ProductId, quantity = l.Quantity, expectedPrice = l.ExpectedPrice })))</script>
<script src="~/js/pos.js" asp-append-version="true"></script>
}
