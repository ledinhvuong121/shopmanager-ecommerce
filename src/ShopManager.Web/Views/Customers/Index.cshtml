@model PagedList<Customer>
@{ ViewData["Title"] = "Khách hàng"; }
<div class="page-heading"><div><div class="eyebrow">KẾT NỐI VỚI KHÁCH HÀNG</div><h1>Khách hàng <span class="count-pill">@Model.TotalCount</span></h1><p>Lưu thông tin để phục vụ tốt hơn trong lần mua tiếp theo.</p></div><a asp-action="Edit" class="btn btn-primary">＋ Thêm khách hàng</a></div><section class="panel"><form method="get" class="search-bar"><label class="visually-hidden" for="search">Tìm khách hàng</label><input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Tên hoặc số điện thoại…" /><button class="btn btn-outline-secondary">Tìm kiếm</button></form><div class="table-responsive"><table class="table"><thead><tr><th>Khách hàng</th><th>Số điện thoại</th><th>Địa chỉ</th><th></th></tr></thead><tbody>@foreach (var c in Model.Items) { <tr><td><strong>@c.Name</strong></td><td>@c.Phone</td><td>@(c.Address ?? "—")</td><td class="text-end"><a asp-action="Edit" asp-route-id="@c.Id">Chỉnh sửa</a></td></tr> } @if (Model.Items.Count == 0) { <tr><td colspan="4" class="empty-cell">Chưa có khách hàng phù hợp.</td></tr> }</tbody></table></div><partial name="_Pagination" /></section>
