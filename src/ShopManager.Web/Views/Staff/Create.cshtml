@model StaffForm
@{ ViewData["Title"] = "Thêm nhân viên"; }
<div class="page-heading"><div><h1>Thêm nhân viên</h1><p>Tài khoản mới chỉ có quyền nhân viên bán hàng.</p></div></div><form method="post" class="panel form-panel"><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /></div><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="off" /></div><div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><small class="subtle">Ít nhất 10 ký tự gồm chữ hoa, chữ thường, số và ký tự đặc biệt. Nhân viên nên đổi mật khẩu sau lần đăng nhập đầu.</small></div><div class="form-actions"><button class="btn btn-primary">Tạo tài khoản</button><a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div></form>
