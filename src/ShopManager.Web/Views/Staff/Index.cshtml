@model IList<ApplicationUser>
@{ ViewData["Title"] = "Nhân viên"; }
<div class="page-heading"><div><div class="eyebrow">ĐỘI NGŨ CỬA HÀNG</div><h1>Nhân viên</h1><p>Quản lý tài khoản và quyền truy cập bán hàng.</p></div><a asp-action="Create" class="btn btn-primary">＋ Thêm nhân viên</a></div><section class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>Họ tên</th><th>Email</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var u in Model) { <tr><td><strong>@u.FullName</strong></td><td>@u.Email</td><td><span class="badge-status @(u.IsActive ? "success" : "muted")">@(u.IsActive ? "Hoạt động" : "Đã khóa")</span></td><td class="text-end"><form asp-action="SetActive" method="post"><input type="hidden" name="id" value="@u.Id" /><input type="hidden" name="active" value="@((!u.IsActive).ToString().ToLowerInvariant())" /><button class="btn btn-sm btn-outline-secondary">@(u.IsActive ? "Khóa tài khoản" : "Mở tài khoản")</button></form></td></tr> } @if (Model.Count == 0) { <tr><td class="empty-cell" colspan="4">Chưa có nhân viên. Thêm tài khoản đầu tiên để bắt đầu.</td></tr> }</tbody></table></div></section>
