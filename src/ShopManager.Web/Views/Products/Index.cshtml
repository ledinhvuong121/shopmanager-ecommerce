@model PagedList<Product>
@{ ViewData["Title"] = "Sản phẩm"; var manager = User.IsInRole(Roles.Manager); var vi = CultureInfo.GetCultureInfo("vi-VN"); }
<div class="page-heading"><div><div class="eyebrow">DANH MỤC KINH DOANH</div><h1>Sản phẩm <span class="count-pill">@Model.TotalCount</span></h1><p>Quản lý thông tin, giá bán và lượng hàng hiện có.</p></div>@if (manager) { <a asp-action="Edit" class="btn btn-primary">＋ Thêm sản phẩm</a> }</div>
<section class="panel"><form method="get" class="search-bar"><label class="visually-hidden" for="search">Tìm sản phẩm</label><input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Tìm theo tên hoặc mã sản phẩm…" /><button class="btn btn-outline-secondary">Tìm kiếm</button><a asp-action="Index" class="btn btn-link">Tất cả</a></form><div class="table-responsive"><table class="table"><thead><tr><th>Sản phẩm</th><th>Danh mục</th><th>Giá bán</th><th>Tồn kho</th><th>Trạng thái</th>@if (manager) { <th></th> }</tr></thead><tbody>
@foreach (var p in Model.Items) { <tr><td><div class="product-cell">@if (ProductImages.Find(p.Sku) is string image) { <img class="product-icon" src="@image" width="40" height="40" style="object-fit:contain" alt="" loading="lazy" /> }
else { <span class="product-icon" aria-hidden="true">▦</span> }<div><strong>@p.Name</strong><small>@p.Sku</small></div></div></td><td>@p.Category.Name</td><td class="money">@p.Price.ToString("N0", vi) ₫</td><td><span class="@(p.Stock <= p.LowStockThreshold ? "low-stock" : "")">@p.Stock</span></td><td><span class="badge-status @(p.IsActive ? "success" : "muted")">@(p.IsActive ? "Đang bán" : "Ngừng bán")</span></td>@if (manager) { <td class="text-end"><a asp-action="Edit" asp-route-id="@p.Id">Chỉnh sửa</a></td> }</tr> }
@if (Model.Items.Count == 0) { <tr><td colspan="6" class="empty-cell">Không tìm thấy sản phẩm. Thử từ khóa khác hoặc thêm sản phẩm đầu tiên.</td></tr> }
</tbody></table></div><partial name="_Pagination" /></section>
