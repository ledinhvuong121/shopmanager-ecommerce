@model ProductForm
@{ ViewData["Title"] = Model.Id == 0 ? "Thêm sản phẩm" : "Chỉnh sửa sản phẩm"; }
<div class="page-heading"><div><a asp-action="Index" class="back-link">← Danh sách sản phẩm</a><h1>@ViewData["Title"]</h1><p>Tồn kho được cập nhật qua nhập hàng và các giao dịch bán.</p></div></div>
<form method="post" class="panel form-panel"><input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" /><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-4"><label asp-for="Sku" class="form-label"></label><input asp-for="Sku" class="form-control" /></div><div class="col-md-8"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div><div class="col-md-6"><label asp-for="CategoryId" class="form-label"></label><select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"><option value="">Chọn danh mục</option></select></div><div class="col-md-6"><label asp-for="Price" class="form-label"></label><input asp-for="Price" type="number" min="1" step="1" class="form-control" /></div><div class="col-md-6"><label asp-for="LowStockThreshold" class="form-label"></label><input asp-for="LowStockThreshold" class="form-control" /></div><div class="col-12"><label class="form-check"><input asp-for="IsActive" class="form-check-input" /><span class="form-check-label">Đang kinh doanh</span></label></div></div><div class="form-actions"><button class="btn btn-primary">Lưu sản phẩm</button><a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div></form>
